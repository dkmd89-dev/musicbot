# services/downloader/download_utils.py
# -*- coding: utf-8 -*-
"""
download_utils.py v4.0 – Vollständig transparente Download-Orchestrierung

Architektur-Übersicht:
  enhanced_download_with_retry()          → Haupt-Einstiegspunkt mit Retry
    ├── _process_playlist_download()      → Playlist-Pipeline (N Tracks)
    │     ├── _resolve_dominant_artist()  → Artist-Routing-Entscheidungsbaum
    │     ├── _resolve_playlist_year()    → Jahr-Bestimmung aus 4 Quellen
    │     ├── _check_enhanced_cache()     → 2-stufiger Cache-Lookup
    │     ├── _download_single_track()    → yt-dlp Audio-Download
    │     └── _process_track_metadata()  → EnhancedMetadataProcessor
    └── _process_single_download()        → Single-Track-Pipeline

Pipeline-Phasen (vollständig geloggt mit [PHASE X]):
  PLAYLIST: ANALYSE → CHANNEL-ROUTING → JAHR → TRACKS(1..N) → STATS
  SINGLE  : CACHE-CHECK → DOWNLOAD → METADATA → ERGEBNIS

Log-Konventionen:
  [RETRY X/N]    – Download-Versuch
  [PL-ANALYSE]   – Playlist-Metadaten-Analyse
  [CHANNEL]      – Artist/Channel-Routing-Entscheidung
  [YEAR]         – Jahr-Bestimmung
  [TRACK XX/NN]  – Einzel-Track innerhalb Playlist
  [CACHE]        – Cache-Lookup-Entscheidung
  [DL]           – yt-dlp Download
  [META]         – Metadaten-Verarbeitung
  [STATS]        – Abschluss-Statistiken

CHANGELOG v4.0:
  ✅ Strukturierte [PHASE]-Marker in jedem Log-Eintrag
  ✅ Entscheidungsbaum-Logging für Channel-Routing (5 Pfade erläutert)
  ✅ Cache-Transparenz: Key, Quelle, Ergebnis bei jedem Lookup
  ✅ yt-dlp Optionen und Datei-Suche vollständig geloggt
  ✅ Per-Track ASCII-Fortschrittsbalken in Playlist-Loops
  ✅ Separater Ergebnis-Block pro Track (Artist, Titel, Quelle, Flags)
  ✅ Jahr-Bestimmung mit Quellen-Logging (release_year / year / upload_date / title)
  ✅ Retry-Backoff mit explizitem Grund-Logging
  ✅ Finale Statistik-Tabelle nach jedem Playlist-Download
"""

import asyncio
import re
from collections import Counter
from datetime import datetime
from pathlib import Path
from typing import Any, Callable, Dict, List, Optional, Tuple

import yt_dlp

from config import Config
from utils.singleton import SingletonMixin
from logger import get_module_logger
from services.downloader.utils.enhanced_metadata_processor import (
    EnhancedMetadataProcessor as MetadataProcessorCore,
    MetadataResult,
)
